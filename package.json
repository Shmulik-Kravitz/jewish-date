{
  "name": "jewish-date",
  "description": "Converts Gregorian dates to Hebrew dates and vice versa.",
  "version": "2.0.24",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/mjs/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./dist/mjs/index.js",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shmulik-Kravitz/jewish-date.git"
  },
  "scripts": {
    "start": "esr ./config/start.ts",
    "build": "yarn lint && yarn clean && esr ./config/build.ts",
    "lint": "yarn biome check ./src",
    "lint-fix": "yarn biome format --write ./src",
    "clean": "rimraf dist && rimraf lib",
    "test": "vitest --config ./config/vitest/vitest.config.ts  --coverage",
    "p": "yarn pack --out %s-%v.tgz",
    "inc-version": "yarn version patch",
    "get-version": "node -p \"require('./package.json').version\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/gematriya": "^2.0.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "esbuild-node-externals": "^1.23.1",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "esbuild-runner": "^2.2.2",
    "fs-extra": "^11.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsc-prog": "^2.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "gematriya": "^2.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "files": [
    "dist",
    "lib"
  ],
  "keywords": [
    "jewish",
    "hebrew",
    "date",
    "luach",
    "calendar",
    "convert",
    "hdate",
    "hebcal",
    "hcal",
    "jewish-date",
    "hebrew-date",
    "jewish-calendar",
    "hebrew-calendar",
    "gregorian",
    "date-converter",
    "date-conversion",
    "format",
    "gematria",
    "leap-year",
    "israel",
    "judaism",
    "typescript"
  ],
  "packageManager": "yarn@4.17.1"
}
